# secrets
.env
.env.local

# python
.venv
.venv/
__pycache__/
*.pyc

# obsidian workspace-local state
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# OS
.DS_Store

# pytest
.pytest_cache/

# claude worktrees (local-only)
.claude/worktrees/
.worktrees/

# V1 runtime data (local only)
data/*.db
data/*.csv

# ClaimRegistry render_views output (regeneratable from registry)
data/arenas/
data/companies/
data/industries/

# claude lock
.claude/scheduled_tasks.lock

# Large source materials (kept local only)
companies/**/sources/*.pdf
prism/inbox/auto/
prism/inbox/manual/
prism/topics/*/inbox/
prism/topics/**/materials/
mineru_summaries/

# Runtime logs (dashboard async trigger etc.)
prism/logs/

.gitnexus
state/
# whitelist overlay state IS version-controlled (learned asset — un-ignore only the JSON artifacts)
!prism/state/
!prism/state/whitelist/
!prism/state/whitelist/overlays/
!prism/state/whitelist/overlays/*.json
!prism/state/whitelist/_promotion_log.json
# re-ignore atomic-write temp files that may be left by SIGKILL
prism/state/whitelist/*.tmp
prism/state/whitelist/overlays/*.tmp
